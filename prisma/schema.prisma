// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String             @id @default(cuid())
  username         String             @unique
  email            String             @unique
  password         String
  avatar           String?
  level            Int                @default(1)
  totalScore       Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  stories          Story[]
  userLearning     UserLearning[]
  dailyRecords     DailyRecord[]
  learningSettings LearningSettings?
}

model Word {
  id           String         @id @default(cuid())
  word         String         @unique
  phonetic     String?
  meaning      String
  partOfSpeech String
  example      String?
  level        Int            @default(1)
  category     String?
  frequency    Int            @default(0)
  createdAt    DateTime       @default(now())
  userLearning UserLearning[]
}

model Story {
  id           String         @id @default(cuid())
  userId       String
  title        String
  content      String
  words        String
  style        String
  wordCount    Int
  imageUrls    String
  status       String         @default("published")
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userLearning UserLearning[]
}

model UserLearning {
  id            String    @id @default(cuid())
  userId        String
  wordId        String
  storyId       String?
  status        String    @default("learning")
  correctCount  Int       @default(0)
  wrongCount    Int       @default(0)
  lastStudiedAt DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  word          Word      @relation(fields: [wordId], references: [id], onDelete: Cascade)
  story         Story?    @relation(fields: [storyId], references: [id])
  
  @@unique([userId, wordId])
}

model DailyRecord {
  id              String    @id @default(cuid())
  userId          String
  studyDate       DateTime
  wordsLearned    Int       @default(0)
  storiesGenerated Int      @default(0)
  studyDuration   Int       @default(0)
  scoreEarned     Int       @default(0)
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, studyDate])
}

model LearningSettings {
  id              String    @id @default(cuid())
  userId          String    @unique
  dailyWordTarget Int       @default(10)
  preferredStyle  String    @default("adventure")
  autoGenerate    Boolean   @default(false)
  reminderTime    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id        String   @id @default(cuid())
  taskId    String   @unique
  status    String   @default("pending")
  data      Json?
  error     String?
  progress  Int?     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
